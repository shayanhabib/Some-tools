// Helper: Delete directory recursively
function deleteDirectory($dir) {
    if (!file_exists($dir)) return;
    if (is_file($dir)) {
        @chmod($dir, 0777);
        return unlink($dir);
    }
    foreach (scandir($dir) as $item) {
        if ($item === '.' || $item === '..') continue;
        deleteDirectory($dir . DIRECTORY_SEPARATOR . $item);
    }
    @chmod($dir, 0777);
    return rmdir($dir);
}

