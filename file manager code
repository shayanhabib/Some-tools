// PERMISSIONS FUNCTION
function getPermissions($file) {
    $perms = fileperms($file);
    $info = '';
    $info .= ($perms & 0x1000) ? 'p' : (($perms & 0x2000) ? 'c' :
             (($perms & 0x4000) ? 'd' : (($perms & 0x6000) ? 'b' :
             (($perms & 0x8000) ? '-' : (($perms & 0xA000) ? 'l' :
             (($perms & 0xC000) ? 's' : 'u'))))));
    // Owner
    $info .= (($perms & 0x0100) ? 'r' : '-');
    $info .= (($perms & 0x0080) ? 'w' : '-');
    $info .= (($perms & 0x0040) ?
                (($perms & 0x0800) ? 's' : 'x' ) :
                (($perms & 0x0800) ? 'S' : '-'));
    // Group
    $info .= (($perms & 0x0020) ? 'r' : '-');
    $info .= (($perms & 0x0010) ? 'w' : '-');
    $info .= (($perms & 0x0008) ?
                (($perms & 0x0400) ? 's' : 'x' ) :
                (($perms & 0x0400) ? 'S' : '-'));
    // World
    $info .= (($perms & 0x0004) ? 'r' : '-');
    $info .= (($perms & 0x0002) ? 'w' : '-');
    $info .= (($perms & 0x0001) ?
                (($perms & 0x0200) ? 't' : 'x' ) :
                (($perms & 0x0200) ? 'T' : '-'));
    return $info;
}

